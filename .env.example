# Copy to .env (git-ignored). galrag reads these via pydantic-settings.
GALRAG_ADS_TOKEN=your-scix-api-token
# The corpus archive (SQLite, LanceDB, models, logs); default: <repo>/data
GALRAG_DATA_DIR=/path/to/shared/galrag/data
# Contact string sent in the User-Agent header for arXiv fetches (optional but polite)
GALRAG_CONTACT=
# Default arXiv RSS category screened by `galrag rss` (rss.arxiv.org/rss/<category>)
# GALRAG_FEED_CATEGORY=astro-ph.GA
# Also accept feed papers whose reranker topic score (0-1) is >= this; ~0.25 adds near-topic papers (0 = keywords only)
# GALRAG_FEED_MIN_SCORE=0
# Machine-local scratch (live SQLite + raw HTML/PDF cache). Heavy I/O stays off the shared
# filesystem; results are pushed to GALRAG_DATA_DIR with `galrag sync push` (the loops do it periodically).
GALRAG_WORK_DIR=/tmp/$USER/galrag
# Optional: LanceDB on local disk; default is $GALRAG_DATA_DIR/lancedb
# GALRAG_LANCEDB_DIR=/scratch/$USER/galrag/lancedb
