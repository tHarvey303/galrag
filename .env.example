# Copy to .env (git-ignored). galrag reads these via pydantic-settings.
GALRAG_ADS_TOKEN=your-scix-api-token
GALRAG_DATA_DIR=/nexus/posix0/MIA-astro-env/andeg/tharvey/agent_work/vector_rag/data
# Contact string sent in the User-Agent header for arXiv fetches (optional but polite)
GALRAG_CONTACT=
# Machine-local scratch (live SQLite + raw HTML/PDF cache). Heavy I/O stays off Nexus;
# results are pushed to GALRAG_DATA_DIR with `galrag sync push` (the loops do it periodically).
GALRAG_WORK_DIR=/tmp/tharvey/galrag
# Optional: LanceDB on local disk (GPU machine); default is $GALRAG_DATA_DIR/lancedb
# GALRAG_LANCEDB_DIR=/scratch/tharvey/galrag/lancedb
